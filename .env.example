# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN SMART PARKING SYSTEM (SPS)
# Sao chép tệp này thành .env và chỉnh sửa mật khẩu PostgreSQL của bạn

# Kết nối PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<db_name>
# Ví dụ: postgresql://postgres:123456@localhost:5432/parking_system
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parking_system

# Secret key ký JWT Token (giữ nguyên khi chạy thử nghiệm trên máy cục bộ)
SECRET_KEY=smart-parking-system-phenikaa-secret-key-2026-very-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Domain Frontend được phép gọi API CORS
FRONTEND_ORIGIN=http://localhost:3000

