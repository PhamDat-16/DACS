# Đổi tên file này thành .env và điền giá trị thật trước khi chạy

# Kết nối PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parking_system

# Secret key để ký JWT - đổi thành chuỗi ngẫu nhiên dài khi deploy thật
# Có thể tạo nhanh bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - domain frontend được phép gọi API
FRONTEND_ORIGIN=http://localhost:3000
